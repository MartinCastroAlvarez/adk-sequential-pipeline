# Copy to .env (never commit it). Every variable is optional. `adk web` / `adk run`
# load a .env next to the agent folder too.
DESK_PROVIDER=ollama                    # ollama | gemini | stub
DESK_MODEL=qwen3:4b                     # gemini-3.5-flash for gemini
OLLAMA_HOST=http://127.0.0.1:11434      # loopback only unless the next line is 1
DESK_ALLOW_REMOTE_OLLAMA=
DESK_TEMPERATURE=0
DESK_MAX_ITERATIONS=3
DESK_APPROVAL_THRESHOLD=8
DESK_MAX_REQUEST_TOKENS=6000
DESK_MAX_RUN_TOKENS=60000
DESK_SUPPORT_THRESHOLD=0.6
DESK_SOURCES=                           # folder of *.md notes; empty = bundled pack
# Only for the optional Gemini provider (your key, your bill):
# GOOGLE_API_KEY=
